      "decimals": 18
    },
    "router": {
      "symbol": "WETH",
      "address": "0x4200000000000000000000000000000000000006",
      "decimals": 18
    }
  },
  "router": {
    "name": "Uniswap V3 SwapRouter02 on Base",
    "address": "0x2626664c2603336E57B271c5C0b26F421741e481",
    "quoter": "0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a"
  },
  "fees": {
    "keeper_bps": 10,
    "protocol_bps": 10,
    "burn_bps": 10,
    "total_bps": 30,
    "note": "Deducted from amountPerSwap before each swap. Burn fee always converts USDC→CLAWD and sends to 0xdead, regardless of target token."
  },
  "constants": {
    "epoch_duration_seconds": 10800,
    "min_amount_per_swap_usdc": "1000000",

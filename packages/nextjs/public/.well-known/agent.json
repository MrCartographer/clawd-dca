    "max_slippage_bps": 1000
  },
  "predecessors": [
    {
      "version": "2.0",
      "address": "0xa16095e72936aD6DAb012ec1b95222F6FCB5f5C2",
      "status": "retired",
      "deployed_block": 46170369,
      "retired": "2026-05-28",
      "explorer": "https://basescan.org/address/0xa16095e72936aD6DAb012ec1b95222F6FCB5f5C2"
    },
    {
      "version": "1.0",
      "address": "0x8c81CAeCA48f521Df24B65F1C22c11150830F088",
      "status": "retired",
      "deployed_block": 45660684,
      "retired": "2026-05-19",
      "explorer": "https://basescan.org/address/0x8c81CAeCA48f521Df24B65F1C22c11150830F088"
    }
  ],
  "capabilities": {
    "reads": [
      "positions(uint256)",
      "getPositionsByOwner(address)",
      "isRipe(uint256)",
      "getRipePositions(uint256[])",
      "currentEpoch()",
      "burnFeeBalance()",
      "protocolFeeBalance()",
      "nextPositionId()"
    ],
    "writes": [
      "createPositionViaWETH(totalUSDC, amountPerSwap, intervalInEpochs, targetToken, usdcWethFee, wethTargetFee, slippageBps)",
      "createPosition(totalUSDC, amountPerSwap, intervalInEpochs, targetToken, swapPath, slippageBps)",
      "executeDCA(positionId)",
      "executeDCAWithMin(positionId, amountOutMinimum)",
      "executeBatch(positionIds)",
      "executeBurn()",
      "withdrawToken(positionId)",
      "closePosition(positionId)"
    ],
    "events": [
      "PositionCreated(positionId, owner, targetToken, totalUSDC, amountPerSwap, intervalInEpochs, slippageBps)",
      "PositionExecuted(positionId, keeper, amountSwapped, tokenReceived, keeperFee, epoch)",
      "PositionClosed(positionId, closedBy, usdcRefunded, tokenRefunded)",
      "TokenWithdrawn(positionId, owner, amount)",
      "BurnExecuted(executor, usdcIn, clawdBurned)",
      "ProtocolFeesWithdrawn(to, amount)"
    ]
  },
  "intents": {
    "stack_token_long_term": {
      "description": "Open a position to DCA into a Base token on a schedule.",
      "primary_call": "createPositionViaWETH",
      "inputs": ["targetToken", "totalUSDC", "amountPerSwap", "intervalInEpochs"]
    },
    "earn_keeper_fees": {
      "description": "Run as a keeper — execute ripe positions and earn 10 bps per execution.",
      "primary_call": "executeDCAWithMin",
      "discover_via": ["getRipePositions", "isRipe"]
    },
    "burn_for_deflation": {
      "description": "Trigger the permissionless USDC→CLAWD burn when burnFeeBalance is meaningful.",
      "primary_call": "executeBurn"
    }
  }
}

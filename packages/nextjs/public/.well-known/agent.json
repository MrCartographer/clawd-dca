    "abi_url": "https://clawd-dca.vercel.app/.well-known/clawd-dca-v3.abi.json",
    "metadata_url": "https://clawd-dca.vercel.app/.well-known/clawd-dca-v3.metadata.json",
    "explorer": "https://basescan.org/address/0xDB5Da5B9C55D5FC72EB19692aB41Aabbc46278AC",
